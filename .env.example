# Copy this file to .env and replace every value before starting Compose.
# .env is ignored by Git and must never be committed.

# Public address advertised to game clients. Use the WAN address for internet
# play, or a LAN/loopback address for local testing.
FIVESERVER_PUBLIC_IP=203.0.113.10

# Database user passwords. The same value initializes the matching MariaDB
# container and is passed to the FiveServer container.
FIVESERVER_FIVE_DB_PASSWORD=change-me-five-db
FIVESERVER_SIX_DB_PASSWORD=change-me-six-db

# Admin panel passwords.
FIVESERVER_FIVE_ADMIN_PASSWORD=change-me-five-admin
FIVESERVER_SIX_ADMIN_PASSWORD=change-me-six-admin

# Interface used to publish the HTTPS admin ports (8181 for five, 8191 for
# six). 127.0.0.1 keeps them local-only; use 0.0.0.0 only when remote admin
# access is intentional and protected.
FIVESERVER_ADMIN_BIND=127.0.0.1

# Log rotation. Twisted's LogFile default was 1,000,000 bytes with unlimited
# numbered backups; these defaults match that behavior.
# Set MAX_BYTES=0 to disable rotation. Leave BACKUP_COUNT empty for unlimited
# backups; 0 keeps only the newest rotated file, N keeps .1 through .N.
FIVESERVER_LOG_MAX_BYTES=1000000
FIVESERVER_LOG_BACKUP_COUNT=

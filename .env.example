# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# --- Database credentials ---
MYSQL_ROOT_PASSWORD=changeme_root
DB_USER=fiveserver
DB_PASSWORD=we9le
DB_NAME=fiveserver
DB_HOST=fiveserver-db
DB_PORT=3306

# --- Flask ---
# FLASK_SECRET=change_me_to_a_random_string

# --- MySQL / MariaDB image ---
MYSQL_IMAGE=mariadb:11

# --- Healthcheck ---
HC_INTERVAL=5s
HC_TIMEOUT=5s
HC_RETRIES=12

# --- Game server ports ---
PORT_NEWS_PES5=16001
PORT_NEWS_WE9=18001
PORT_NEWS_WE9LE=19501
PORT_MAIN=20100
PORT_MENU=20101
PORT_LOGIN_PES5=20102
PORT_LOGIN_WE9=20103
PORT_LOGIN_WE9LE=20104

# --- Web ports ---
PORT_HTTP=80
PORT_HTTPS=443

# --- Go admin API (internal Docker hostname — change only for non-Docker setups) ---
GO_API_HOST=fiveserver

# --- TLS (optional — paths inside the web container) ---
# CERT_FILE=/app/etc/keys/servercert.pem
# KEY_FILE=/app/etc/keys/serverkey.pem
